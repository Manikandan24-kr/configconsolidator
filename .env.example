# ── AI ────────────────────────────────────────────────────────────
# Required for live extraction. Without this, cached results are used.
OPENAI_API_KEY=sk-your-key-here

# ── Database ──────────────────────────────────────────────────────
# Leave blank to use SQLite (development).
# Set for PostgreSQL (production / Docker).
DATABASE_URL=postgresql://kriyadocs:kriyadocs_secret@localhost:5432/kriyadocs

# ── PostgreSQL (only used by docker-compose) ──────────────────────
POSTGRES_USER=kriyadocs
POSTGRES_PASSWORD=kriyadocs_secret
POSTGRES_DB=kriyadocs
